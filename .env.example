# Docker Compose lee automáticamente un archivo ".env" (sin ".example") en
# esta misma carpeta. Copia este archivo a ".env" y completa tus datos de
# Cloudinary para que la subida de fotos/logos funcione en /admin.
# Ver README, sección "Fotos de candidatos y logos de partido".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
