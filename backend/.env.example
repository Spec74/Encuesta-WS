# Cadena de conexión a PostgreSQL (Render la genera automáticamente si usas render.yaml)
DATABASE_URL="postgresql://usuario:password@host:5432/willasayki"

# Salt del servidor para hashear IP/user-agent (nunca lo publiques ni reutilices entre entornos)
HASH_SALT="genera-un-valor-aleatorio-largo-y-unico"

# Orígenes permitidos por CORS, separados por coma (dominios del frontend en Vercel)
CORS_ORIGINS="http://localhost:3000,https://willasayki.pe,https://encuestas.willasayki.pe"

# Token del panel de administración (envíalo como "Authorization: Bearer <token>")
ADMIN_TOKEN="genera-otro-valor-aleatorio-distinto-al-hash-salt"

PORT=4000
