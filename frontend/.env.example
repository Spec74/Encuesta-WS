# URL pública del sitio (usada en metadatos Open Graph para Facebook)
NEXT_PUBLIC_SITE_URL="https://encuestas.willasayki.pe"

# URL base de la API del backend desplegado en Render
NEXT_PUBLIC_API_URL="https://willasayki-encuestas-api.onrender.com/api"

# Subida de fotos de candidatos y logos de partido (cuenta gratuita en
# cloudinary.com). Ver README, sección "Fotos de candidatos y logos de
# partido". Sin estas dos variables, el panel /admin sigue funcionando
# pero el botón "Subir imagen" mostrará un error.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
